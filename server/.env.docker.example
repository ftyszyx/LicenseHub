RUST_BACKTRACE=1
TZ=Asia/Shanghai

# database - 使用 1Panel 已有 PostgreSQL 容器
DATABASE_NAME=hub
DATABASE_USER=hub
DATABASE_PASSWORD=change_me_1panel_postgres_password
DATABASE_PORT=5432
DATABASE_HOST=1Panel-postgresql-OqC3
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT=8

# server
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE=7
LISTEN_PORT=3000
LISTEN_OUT_PORT=21600
LISTEN_HOST=0.0.0.0

# log
RUST_LOG=info,app_server=info,tower_http=debug,sea_orm=info,sqlx=warn,salvo_extra::logging=warn

# redis - 使用 1Panel 已有 Redis 容器
REDIS_PORT=6379
REDIS_HOST=1Panel-redis-mpua
REDIS_USERNAME=
REDIS_PASSWORD=change_me_1panel_redis_password
REDIS_KEY_PREFIX=hub_

# 注册是否开放 false 不开放 true 开放
REGISTER_OPEN=false

# payment
# Global payment switch. Individual WeChat/Alipay channels are enabled in Admin > Payment Settings.
PAYMENT_ENABLED=false
# Public backend base URL used to generate notify URLs: {PUBLIC_BASE_URL}/api/pay/{pay_type}/notify
PUBLIC_BASE_URL=https://appapi.example.com
# Public frontend base URL used for Alipay return_url after the browser payment flow.
FRONTEND_BASE_URL=https://apps.example.com
# Site name used in payment order display text.
PAYMENT_SITE_NAME=LicenseHub
