RUST_BACKTRACE=1
TZ=Asia/Shanghai

# database - 使用 1Panel 已有 PostgreSQL 容器
DATABASE_NAME=hub
DATABASE_USER=hub
DATABASE_PASSWORD=change_me_1panel_postgres_password
DATABASE_PORT=5432
DATABASE_HOST=1Panel-postgresql-OqC3
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT=8

# server
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE=7
LISTEN_PORT=3000
LISTEN_OUT_PORT=21600
LISTEN_HOST=0.0.0.0

# log
RUST_LOG=info,app_server=info,tower_http=debug,sea_orm=info,sqlx=warn,salvo_extra::logging=warn

# redis - 使用 1Panel 已有 Redis 容器
REDIS_PORT=6379
REDIS_HOST=1Panel-redis-mpua
REDIS_USERNAME=
REDIS_PASSWORD=change_me_1panel_redis_password
REDIS_KEY_PREFIX=hub_

# 注册是否开放 false 不开放 true 开放
REGISTER_OPEN=false

# payment
PAYMENT_ENABLED=false
PAYMENT_PAY_TYPES=wechat_native
PUBLIC_BASE_URL=https://appapi.example.com
FRONTEND_BASE_URL=https://apps.example.com
PAYMENT_SITE_NAME=LicenseHub
WECHAT_PAY_ENABLED=true
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/wechatpay_apiclient_key.pem
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechatpay_platform_public_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
