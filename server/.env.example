RUST_BACKTRACE=1
TZ=Asia/Shanghai
# database
DATABASE_NAME=hub
DATABASE_USER=test
DATABASE_PASSWORD=123456
DATABASE_PORT=5432
DATABASE_HOST=localhost


# server
JWT_SECRET=123456
EMAIL_CODE_SECRET=replace_with_a_separate_long_random_secret
JWT_EXPIRE_DAY=7

LISTEN_PORT=3000  # 内网端口
LISTEN_OUT_PORT=21600  # 外网端口
LISTEN_HOST=0.0.0.0
#log
RUST_LOG=info,app_server=info,tower_http=debug,sea_orm=info,sqlx=warn,salvo_extra::logging=warn

#redis
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=123456
REDIS_KEY_PREFIX=hub_


#注册是否开放 false 不开放 true 开放
REGISTER_OPEN=false

# payment
# Global payment switch. Individual WeChat/Alipay channels are enabled in Admin > Payment Settings.
PAYMENT_ENABLED=false
# Public backend base URL used to generate notify URLs: {PUBLIC_BASE_URL}/api/pay/{pay_type}/notify
PUBLIC_BASE_URL=http://localhost:3000
# Public frontend base URL used for Alipay return_url after the browser payment flow.
FRONTEND_BASE_URL=http://localhost:9070
# Site name used in payment order display text.
PAYMENT_SITE_NAME=LicenseHub

# License signing key id for app activation responses.
# The private key is generated and stored from Admin > System Settings.
LICENSE_SIGNING_KEY_ID=license-v1
